{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxyris",
  "version": "0.1.0",
  "identifier": "dev.oxyris.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../web",
      "wait": true
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxyris",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$LOCALAPPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Oxyris",
    "category": "DeveloperTool",
    "shortDescription": "Desktop coding agent for Windows + WSL",
    "longDescription": "Multi-session, multi-worktree Claude desktop client with first-class WSL support.",
    "copyright": "Oxyris Contributors",
    "homepage": "https://github.com/oxyris-code",
    "licenseFile": "../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/oxyris-code/oxyris/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_REAL_KEY_FROM_`tauri signer generate`"
    }
  }
}
