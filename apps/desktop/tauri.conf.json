{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxyris",
  "version": "0.4.12",
  "identifier": "dev.oxyris.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../web",
      "wait": true
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxyris",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$LOCALAPPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Oxyris",
    "category": "DeveloperTool",
    "shortDescription": "Desktop coding agent for Windows, macOS, Linux + WSL",
    "longDescription": "Multi-session, multi-worktree Claude desktop client. Runs natively on Windows, macOS, and Linux, with first-class WSL support on Windows hosts.",
    "copyright": "Oxyris Contributors",
    "homepage": "https://github.com/oxyris-code",
    "licenseFile": "../../LICENSE"
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/wilsonglasser/oxyris/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RkVBNUE4OENCNUI0NzkKUldSNXRMV01xS1greFhZYTRsYVR3WTJtWHlteG91VG9UMzNPS1hYN0tZS0VlbHEyV0pZd1M0N0QK"
    }
  }
}
